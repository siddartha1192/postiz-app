# ─── Database ───
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_poster?schema=public"
REDIS_URL="redis://localhost:6379"

# ─── Auth ───
JWT_SECRET="change-me-to-a-random-secret"
JWT_EXPIRATION="7d"

# ─── Domain & SSL ───
# Your domain name (e.g., climcrm.com) — used by nginx-proxy for SSL
APP_DOMAIN="climcrm.com"
# Email for Let's Encrypt certificate notifications
CERTBOT_EMAIL="your@email.com"

# ─── URLs ───
# MUST use https:// in production (nginx-proxy handles SSL)
FRONTEND_URL="https://climcrm.com"
BACKEND_URL="https://climcrm.com"

# ─── Cookies ───
# Set to true when using HTTPS (default: true in production)
COOKIE_SECURE=true

# ─── Storage ───
STORAGE_PROVIDER="local"
UPLOAD_DIRECTORY="./uploads"

# ─── OpenAI ───
OPENAI_API_KEY=""

# ─── Social Media OAuth ───
# Twitter/X
X_API_KEY=""
X_API_SECRET=""

# LinkedIn
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# Facebook / Instagram
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
FACEBOOK_WEBHOOK_VERIFY_TOKEN="postiz_webhook_verify"

# YouTube
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""

# TikTok
TIKTOK_CLIENT_ID=""
TIKTOK_CLIENT_SECRET=""

# Reddit
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""

# Pinterest
PINTEREST_CLIENT_ID=""
PINTEREST_CLIENT_SECRET=""

# Discord
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
DISCORD_BOT_TOKEN=""

# Slack
SLACK_CLIENT_ID=""
SLACK_CLIENT_SECRET=""

# Mastodon
MASTODON_CLIENT_ID=""
MASTODON_CLIENT_SECRET=""
MASTODON_URL=""

# Bluesky (no OAuth - uses app password)
# Dribbble
DRIBBBLE_CLIENT_ID=""
DRIBBBLE_CLIENT_SECRET=""

# Threads (uses Facebook OAuth)
